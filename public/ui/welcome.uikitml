<style>
  .panel-root {
    background-color: #0b0f18;
    border-color: #303849;
    border-radius: 20px;
    border-width: 1px;
    flex-direction: column;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    width: 380px;
  }

  .eyebrow {
    color: #74d8f1;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    line-height: 14px;
  }

  .heading {
    color: #f7f8fb;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 28px;
    margin-top: 12px;
    text-align: left;
    width: 100%;
  }

  .sub-heading {
    color: #a7b0c0;
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
    margin-top: 8px;
    text-align: left;
    width: 100%;
  }

  .steps {
    flex-direction: row;
    gap: 8px;
    margin-top: 16px;
    width: 100%;
  }

  .step {
    background-color: #151b28;
    border-color: #2b3445;
    border-radius: 12px;
    border-width: 1px;
    flex-direction: column;
    flex-grow: 1;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
  }

  .step-label {
    color: #f7f8fb;
    font-size: 12px;
    font-weight: 700;
    line-height: 15px;
  }

  .monitor {
    background-color: #101621;
    border-color: #293347;
    border-radius: 12px;
    border-width: 1px;
    flex-direction: column;
    margin-top: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    width: 100%;
  }

  .section-label {
    color: #8f9caf;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    line-height: 12px;
  }

  .status {
    color: #a7b0c0;
    font-size: 13px;
    font-weight: 600;
    line-height: 17px;
    margin-top: 4px;
  }

  .button {
    justify-content: flex-start;
    margin-top: 14px;
    width: 100%;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="eyebrow">GLASSES WEB FOUNDATION</div>
  <div class="heading">Basics bench</div>
  <div class="sub-heading">
    Look at a numbered tile, pinch to select, and use the field-of-view mask to
    see what stays inside the glasses view profile.
  </div>
  <div class="steps">
    <div class="step">
      <div class="step-label">Look</div>
    </div>
    <div class="step">
      <div class="step-label">Pinch</div>
    </div>
    <div class="step">
      <div class="step-label">See FOV</div>
    </div>
  </div>
  <div class="monitor">
    <div class="section-label">INTERACTION</div>
    <div id="interaction-status" class="status">
      Ready - look at a tile (Gaze + Hands)
    </div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
